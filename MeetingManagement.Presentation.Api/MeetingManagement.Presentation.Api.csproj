<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <UserSecretsId>meeting-management-api</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.0" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.12" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Newtonsoft.Json" Version="14.0.1-beta2" />
        <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="10.2.1" />
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.2.1" />
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.1" />
    </ItemGroup>



    <ItemGroup>
      <Folder Include="wwwroot\assets\" />
    </ItemGroup>



    <ItemGroup>
      <ProjectReference Include="..\MeetingManagement.Application.Contracts\MeetingManagement.Application.Contracts.csproj" />
      <ProjectReference Include="..\MeetingManagement.Infrastructure.Configuration\MeetingManagement.Infrastructure.Configuration.csproj" />
      <ProjectReference Include="..\MeetingManagement.Presentation.Facade.Contracts\MeetingManagement.Presentation.Facade.Contracts.csproj" />
    </ItemGroup>

</Project>
