{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // روی سرور: متغیر محیطی ConnectionStrings__Application یا appsettings.Production.json (خارج از مخزن)
    "Application": ""
  },
  "IdentityAuthorities": [
    "https://localhost:7001"
  ],
  "AllowedOrigins": [
    "http://localhost:4200",
    "http://localhost:5200",
    "http://localhost:7200"
  ],
  "BoardCategoryGuid": "FA370076-D2A9-4546-B00C-71DE1A370306",
  "ssoDatabaseName": "AuthenticationManagement",
  "UserManagementUrl": "https://localhost:6001",
  "FileManagementUrl": "https://localhost:4001",
  "FileManagement": {
    // کلید مشترک با FileSettings:SignatureUrlKey در سامانه‌ی مدیریت فایل (در Production از Secret/متغیر محیطی)
    "SignatureUrlKey": "",
    "SignatureUrlLifetimeMinutes": 60
  },
  "SmsUrl": "http://sms.epciran.ir",



  // توکن سرویس-به-سرویس برای Job های اطلاع‌رسانی (دریافت موبایل کاربران بدون حضور کاربر)
  // در SSO برای سیستم MeetManage گزینه HasS2S را فعال کنید.
  "S2S": {
    "ClientId": "MeetManage.s2s",
    "ClientSecret": "__SET_ON_SERVER__",
    "Scope": "UserManagementApi"
  },

  // اعلان لحظه‌ای: علاوه بر SignalR همین سامانه (/hubs/notifications)، رویدادها به پرتال SSO هم ارسال می‌شوند.
  // SharedSecret باید با Realtime:Sources (Name = SourceName) در appsettings سامانه SSO یکی باشد؛ فقط روی سرور مقداردهی شود.
  "Realtime": {
    "Sso": {
      "Url": "",
      "SourceName": "MeetManage",
      "SharedSecret": ""
    }
  },

  "Auth": { "RequireHttpsMetadata": false, "ClientId": "MeetManage" }
}
