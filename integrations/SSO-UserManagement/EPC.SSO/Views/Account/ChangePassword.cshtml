@model EPC.SSO.SettingModels.ChangePassword
@{
    Layout = "_Layout";
    ViewData["Title"] = "تغییر رمز عبور";
}

@section style {
    <style>
        .cp-page {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2.5rem 1rem;
            min-height: calc(100vh - var(--header-h) - 60px);
        }

        .cp-shell {
            display: grid;
            grid-template-columns: 1fr 210px;
            max-width: 700px;
            width: 100%;
            border-radius: var(--radius-lg);
            overflow: hidden;
            border: 1px solid var(--card-border);
            box-shadow: var(--shadow-lg);
        }

        /* ─── پنل چپ: فرم ─────────────────────────────────────── */
        .cp-form-panel {
            background: var(--white);
            padding: 2rem 1.75rem;
        }

        .cp-header {
            margin-bottom: 1.6rem;
        }

        .cp-icon-ring {
            width: 46px;
            height: 46px;
            border-radius: 50%;
            background: var(--inner-bg);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: .85rem;
        }

            .cp-icon-ring i {
                font-size: 20px;
                color: var(--text-light);
            }

        .cp-header h2 {
            font-size: 16px;
            font-weight: 700;
            color: var(--navy);
            margin-bottom: 4px;
        }

        .cp-header p {
            font-size: 12px;
            color: var(--text-light);
            line-height: 1.55;
        }

        .cp-field {
            margin-bottom: 1.1rem;
        }

        .cp-label {
            display: block;
            font-size: 12px;
            color: var(--text-mid);
            margin-bottom: 5px;
        }

        .cp-inp-wrap {
            position: relative;
        }

        .cp-input {
            width: 100%;
            padding: 9px 13px 9px 38px;
            font-size: 13px;
            font-family: 'Vazirmatn', sans-serif;
            border: 1.5px solid var(--border);
            border-radius: var(--radius-sm);
            background: var(--inner-bg);
            color: var(--text-dark);
            outline: none;
            direction: rtl;
            transition: border-color .2s, box-shadow .2s;
            box-sizing: border-box;
        }

            .cp-input:focus {
                border-color: var(--navy);
                box-shadow: 0 0 0 3px rgba(28,39,81,0.08);
            }

            .cp-input.is-valid {
                border-color: #1D9E75;
            }

            .cp-input.is-invalid {
                border-color: #E24B4A;
            }

        .cp-eye {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-light);
            font-size: 17px;
            line-height: 1;
            padding: 2px;
        }

        .cp-bars {
            display: flex;
            gap: 3px;
            margin: 8px 0 4px;
        }

        .cp-bar {
            flex: 1;
            height: 3px;
            border-radius: 3px;
            background: var(--border);
            transition: background .35s;
        }

        .cp-str-label {
            font-size: 11px;
            color: var(--text-light);
            text-align: left;
            min-height: 14px;
            transition: color .3s;
        }

        .cp-match {
            font-size: 11px;
            margin-top: 4px;
            min-height: 14px;
        }

        .cp-submit {
            width: 100%;
            padding: 10px;
            font-size: 13px;
            font-family: 'Vazirmatn', sans-serif;
            border-radius: var(--radius-sm);
            border: 1.5px solid var(--border);
            background: var(--inner-bg);
            color: var(--text-light);
            cursor: not-allowed;
            transition: all .25s;
            margin-top: .35rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

            .cp-submit.ready {
                background: var(--navy);
                border-color: var(--navy);
                color: #fff;
                cursor: pointer;
            }

                .cp-submit.ready:hover {
                    background: var(--navy-light);
                    border-color: var(--navy-light);
                }

            .cp-submit i {
                font-size: 15px;
            }

        .cp-validation {
            background: rgba(226,75,74,0.07);
            border: 1px solid rgba(226,75,74,0.25);
            border-radius: var(--radius-sm);
            padding: 9px 13px;
            margin-bottom: 1rem;
            font-size: 12px;
            color: #A32D2D;
        }

        /* ─── پنل راست: شرط‌ها ────────────────────────────────── */
        .cp-req-panel {
            background: var(--bg);
            border-right: 1px solid var(--card-border);
            padding: 1.5rem 1.1rem;
            display: flex;
            flex-direction: column;
            gap: 1.1rem;
        }

        .rp-section-title {
            font-size: 10px;
            font-weight: 700;
            color: var(--text-light);
            letter-spacing: .06em;
            text-transform: uppercase;
            margin-bottom: .5rem;
        }

        .req-list {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .req-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 7px 10px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border);
            background: var(--white);
            transition: all .3s;
        }

            .req-item.ok {
                background: #E1F5EE;
                border-color: #5DCAA5;
            }

        .req-dot {
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: var(--inner-bg);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: all .3s;
        }

        .req-item.ok .req-dot {
            background: #1D9E75;
            border-color: #1D9E75;
        }

        .req-dot i {
            font-size: 12px;
            color: var(--text-light);
            transition: color .3s;
        }

        .req-item.ok .req-dot i {
            color: #fff;
        }

        .req-text {
            font-size: 11px;
            color: var(--text-mid);
            line-height: 1.35;
            transition: color .3s;
        }

        .req-item.ok .req-text {
            color: #085041;
        }

        /* قدرت pill */
        .str-pill {
            display: inline-block;
            font-size: 11px;
            font-weight: 700;
            padding: 4px 12px;
            border-radius: 20px;
            border: 1px solid var(--border);
            background: var(--white);
            color: var(--text-light);
            transition: all .3s;
            min-width: 72px;
            text-align: center;
        }

        /* ─── Responsive ──────────────────────────────────────── */
        @@media (max-width: 600px) {
            .cp-shell {
                grid-template-columns: 1fr;
            }

            .cp-req-panel {
                border-right: none;
                border-top: 1px solid var(--card-border);
            }

            .req-list {
                display: grid;
                grid-template-columns: 1fr 1fr;
            }
        }
    </style>
}

<div class="cp-page">
    <div class="cp-shell">

        <div class="cp-form-panel">

            <div class="cp-header">
                <div class="cp-icon-ring"><i class="fas fa-lock"></i></div>
                <h2>تغییر رمز عبور</h2>
                <p>رمز جدید باید تمام شرط‌های ستون کناری را داشته باشد.</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="cp-validation" asp-validation-summary="All"></div>
            }

            <form method="post" id="cpForm" novalidate>
                @Html.AntiForgeryToken()

                <div class="cp-field">
                    <label class="cp-label" asp-for="CurrentPassword">رمز عبور فعلی</label>
                    <div class="cp-inp-wrap">
                        <input class="cp-input" type="password" asp-for="CurrentPassword"
                               id="curP" placeholder="رمز فعلی را وارد کنید" required />
                        <button type="button" class="cp-eye" onclick="cpTog('curP','ec')" aria-label="نمایش/پنهان رمز">
                            <i id="ec" class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="cp-field">
                    <label class="cp-label" asp-for="Password">رمز عبور جدید</label>
                    <div class="cp-inp-wrap">
                        <input class="cp-input" type="password" asp-for="Password"
                               id="newP" placeholder="رمز جدید را وارد کنید"
                               oninput="cpEval()" required />
                        <button type="button" class="cp-eye" onclick="cpTog('newP','en')" aria-label="نمایش/پنهان رمز">
                            <i id="en" class="fas fa-eye"></i>
                        </button>
                    </div>
                    <div class="cp-bars">
                        <div class="cp-bar" id="cpb0"></div>
                        <div class="cp-bar" id="cpb1"></div>
                        <div class="cp-bar" id="cpb2"></div>
                        <div class="cp-bar" id="cpb3"></div>
                    </div>
                    <div class="cp-str-label" id="cpsl"></div>
                </div>

                <div class="cp-field">
                    <label class="cp-label" asp-for="RePassword">تکرار رمز عبور جدید</label>
                    <div class="cp-inp-wrap">
                        <input class="cp-input" type="password" asp-for="RePassword"
                               id="repP" placeholder="رمز جدید را تکرار کنید"
                               oninput="cpEval()" required />
                        <button type="button" class="cp-eye" onclick="cpTog('repP','er')" aria-label="نمایش/پنهان رمز">
                            <i id="er" class="fas fa-eye"></i>
                        </button>
                    </div>
                    <div class="cp-match" id="cpmm"></div>
                </div>

                <button type="submit" class="cp-submit" id="cpsb" disabled>
                    <i class="fas fa-key"></i>
                    تغییر رمز عبور
                </button>

            </form>
        </div>

        <div class="cp-req-panel">

            <div>
                <div class="rp-section-title">شرط‌های رمز عبور</div>
                <div class="req-list">
                    <div class="req-item" id="cpr0">
                        <div class="req-dot"><i class="fas fa-check"></i></div>
                        <div class="req-text">حداقل ۸ کاراکتر</div>
                    </div>
                    <div class="req-item" id="cpr1">
                        <div class="req-dot"><i class="fas fa-check"></i></div>
                        <div class="req-text">حروف کوچک (a-z)</div>
                    </div>
                    <div class="req-item" id="cpr2">
                        <div class="req-dot"><i class="fas fa-check"></i></div>
                        <div class="req-text">حروف بزرگ (A-Z)</div>
                    </div>
                    <div class="req-item" id="cpr3">
                        <div class="req-dot"><i class="fas fa-check"></i></div>
                        <div class="req-text">عدد (0-9)</div>
                    </div>
                    <div class="req-item" id="cpr4">
                        <div class="req-dot"><i class="fas fa-check"></i></div>
                        <div class="req-text">کاراکتر خاص<br>(!@@#$%^&amp;*)</div>
                    </div>
                </div>
            </div>

            <div>
                <div class="rp-section-title">قدرت رمز</div>
                <div class="str-pill" id="cpsp">—</div>
            </div>

        </div>
    </div>
</div>

@section scripts {
    <partial name="_ValidationScripts" />
    <script>
        (function () {
            var chks = [
                function (p) { return p.length >= 8; },
                function (p) { return /[a-z]/.test(p); },
                function (p) { return /[A-Z]/.test(p); },
                function (p) { return /[0-9]/.test(p); },
                function (p) { return /[!@@#$%^&*]/.test(p); }
            ];
            var bclr = ['#E24B4A', '#EF9F27', '#EF9F27', '#639922', '#1D9E75'];
            var stxt = ['', 'ضعیف', 'متوسط', 'متوسط', 'قوی', 'بسیار قوی'];
            var spbg = ['', '#FCEBEB', '#FAEEDA', '#FAEEDA', '#EAF3DE', '#E1F5EE'];
            var sptx = ['', '#A32D2D', '#633806', '#633806', '#27500A', '#085041'];
            var spbd = ['', '#F09595', '#EF9F27', '#EF9F27', '#97C459', '#5DCAA5'];

            window.cpEval = function () {
                var p = document.getElementById('newP').value;
                var r = document.getElementById('repP').value;
                var passed = chks.map(function (c) { return c(p); });
                var score = passed.filter(Boolean).length;

                passed.forEach(function (ok, i) {
                    var el = document.getElementById('cpr' + i);
                    if (ok) el.classList.add('ok'); else el.classList.remove('ok');
                });

                for (var i = 0; i < 4; i++) {
                    document.getElementById('cpb' + i).style.background =
                        i < score ? bclr[Math.min(score - 1, 4)] : 'var(--border)';
                }

                var sl = document.getElementById('cpsl');
                var sp = document.getElementById('cpsp');
                var idx = Math.min(score, 5);
                if (p.length === 0) {
                    sl.textContent = ''; sp.textContent = '—';
                    sp.style.background = 'var(--white)';
                    sp.style.color = 'var(--text-light)';
                    sp.style.borderColor = 'var(--border)';
                } else {
                    sl.textContent = 'قدرت: ' + stxt[idx];
                    sl.style.color = bclr[Math.min(score - 1, 4)] || 'var(--text-light)';
                    sp.textContent = stxt[idx] || '—';
                    sp.style.background = spbg[idx] || 'var(--white)';
                    sp.style.color = sptx[idx] || 'var(--text-light)';
                    sp.style.borderColor = spbd[idx] || 'var(--border)';
                }

                var mm = document.getElementById('cpmm');
                var ri = document.getElementById('repP');
                var ni = document.getElementById('newP');
                if (r.length === 0) {
                    mm.textContent = ''; ri.className = 'cp-input'; ni.className = 'cp-input';
                } else if (p === r) {
                    mm.textContent = '✓ رمزها یکسان هستند'; mm.style.color = '#1D9E75';
                    ri.className = 'cp-input is-valid';
                } else {
                    mm.textContent = 'رمزها یکسان نیستند'; mm.style.color = '#E24B4A';
                    ri.className = 'cp-input is-invalid';
                }
                if (p.length > 0)
                    ni.className = 'cp-input ' + (passed.every(Boolean) ? 'is-valid' : '');

                var ready = passed.every(Boolean) && p === r && r.length > 0;
                var sb = document.getElementById('cpsb');
                sb.disabled = !ready;
                if (ready) sb.classList.add('ready'); else sb.classList.remove('ready');
            };

            window.cpTog = function (id, ic) {
                var inp = document.getElementById(id);
                var i = document.getElementById(ic);
                var show = inp.type === 'password';
                inp.type = show ? 'text' : 'password';
                i.className = show ? 'fas fa-eye-slash' : 'fas fa-eye';
            };
        })();
    </script>
}
