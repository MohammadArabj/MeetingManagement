@using EPC.SSO.Services
@model PhoneDirectoryPaginatedResult?
@{
    Layout = "_Layout";
    ViewData["Title"] = "دفترچه تلفن عمومی";
}
@section style {
    <link href="~/css/phone-directory.css" rel="stylesheet" asp-append-version="true" />
}

<div class="pd-page" data-view="cards">

    <!-- هدر -->
    <header class="pd-hero">
        <div class="pd-wrap pd-hero-inner">
            <div class="pd-brand">
                <div class="pd-brand-icon"><i class="fas fa-address-book"></i></div>
                <div>
                    <h1 class="pd-title">دفترچه تلفن سازمان</h1>
                    <p class="pd-subtitle">
                        شماره تماس همکاران و واحدها —
                        <b id="totalCount">…</b> مورد
                    </p>
                </div>
            </div>
            @* <a asp-controller="Login" asp-action="Login" class="pd-login">
                <i class="fas fa-sign-in-alt"></i>
                <span>ورود به سیستم</span>
            </a> *@
        </div>
    </header>

    <div class="pd-wrap">

        <!-- جستجو + فیلتر + نحوه‌ی نمایش -->
        <form id="searchForm" class="pd-toolbar" role="search" autocomplete="off">
            <div class="pd-search">
                <input type="search" id="searchInput" name="search"
                       placeholder="نام، سمت، واحد یا شماره تلفن را بنویسید" aria-label="جستجو" />
                <i class="fas fa-search pd-search-icon"></i>
                <button type="button" class="pd-clear" id="clearBtn" aria-label="پاک کردن جستجو">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <input type="hidden" id="typeFilter" name="type" value="" />
            <div class="pd-chips" id="typeChips">
                <button type="button" class="pd-chip is-active" data-type="" aria-pressed="true">همه</button>
                <button type="button" class="pd-chip" data-type="1" aria-pressed="false">
                    <i class="fas fa-user-tie"></i> سمت‌ها
                </button>
                <button type="button" class="pd-chip" data-type="2" aria-pressed="false">
                    <i class="fas fa-map-marker-alt"></i> مکان‌ها
                </button>
            </div>

            <div class="pd-views" id="viewSwitch" role="group" aria-label="نحوه‌ی نمایش">
                <button type="button" class="pd-vbtn is-active" data-view="cards" aria-pressed="true"
                        title="نمایش به‌صورت کارت">
                    <i class="fas fa-th-large"></i><span>کارت‌ها</span>
                </button>
                <button type="button" class="pd-vbtn" data-view="tiles" aria-pressed="false"
                        title="نمایش پروفایلی با عکس بزرگ">
                    <i class="fas fa-id-card"></i><span>پروفایل</span>
                </button>
                <button type="button" class="pd-vbtn" data-view="list" aria-pressed="false"
                        title="نمایش به‌صورت لیست">
                    <i class="fas fa-list"></i><span>لیست</span>
                </button>
                <button type="button" class="pd-vbtn" data-view="compact" aria-pressed="false"
                        title="نمایش فشرده">
                    <i class="fas fa-th"></i><span>فشرده</span>
                </button>
            </div>
        </form>

        <!-- راهنما: فقط تا وقتی کاربر نحوه‌ی نمایش را انتخاب نکرده -->
        <div class="pd-hint" id="viewHint" hidden>
            <i class="fas fa-magic"></i>
            <span>نحوه‌ی نمایش را از دکمه‌های بالا انتخاب کنید — انتخاب شما ذخیره می‌شود و دفعه‌ی بعد هم همان را می‌بینید.</span>
        </div>

        <!-- نتایج -->
        <main class="pd-results" id="resultsContainer" aria-live="polite"></main>
        @if (Model is not null)
        {
            @* صفحه‌ی اول آماده (از کش SSO) — اسکریپت بدون درخواست دوم نمایشش می‌دهد *@
            <template id="pdInitial"><partial name="_DirectoryResults" model="Model" /></template>
        }

        <!-- صفحه‌بندی -->
        <nav class="pd-pager-host" id="paginationContainer" aria-label="صفحه‌بندی"></nav>
    </div>
</div>

<!-- پیام کوتاه بعد از انتخاب نحوه‌ی نمایش -->
<div class="pd-toast" id="viewToast" role="status" aria-live="polite">
    <i class="fas fa-check"></i><span id="viewToastText"></span>
</div>

@section scripts {
    <script>
        function initPhoneDirectory() {
            const PAGE_SIZE = 12;
            const MAX_ATTEMPTS = 4;          // تعداد دفعات تلاش برای دریافت اطلاعات
            const SEARCH_URL = '@Url.Action("SearchPaginated", "PhoneDirectory")';

            const VIEW_KEY = 'pd:view';
            const VIEWS = {
                cards: 'کارت‌ها',
                tiles: 'پروفایل',
                list: 'لیست',
                compact: 'فشرده'
            };

            const root = document.querySelector('.pd-page');
            const form = document.getElementById('searchForm');
            const searchInput = document.getElementById('searchInput');
            const typeInput = document.getElementById('typeFilter');
            const chips = document.querySelectorAll('.pd-chip');
            const viewBtns = document.querySelectorAll('.pd-vbtn');
            const viewHint = document.getElementById('viewHint');
            const toast = document.getElementById('viewToast');
            const toastText = document.getElementById('viewToastText');
            const results = document.getElementById('resultsContainer');
            const pager = document.getElementById('paginationContainer');
            const totalEl = document.getElementById('totalCount');
            const clearBtn = document.getElementById('clearBtn');

            if (!root || !form || !searchInput || !results || !pager) {
                console.error('PhoneDirectory: required elements not found.');
                return;
            }

            let page = 1;
            let timer = null;
            let controller = null;

            const sleep = ms => new Promise(resolve => setTimeout(resolve, ms));
            const fa = n => Number(n).toLocaleString('fa-IR');

            // ─────────────── نحوه‌ی نمایش (ذخیره در مرورگر) ───────────────

            function readSavedView() {
                try {
                    const v = localStorage.getItem(VIEW_KEY);
                    return v && VIEWS[v] ? v : null;
                } catch { return null; }
            }

            function saveView(v) {
                try {
                    localStorage.setItem(VIEW_KEY, v);
                    return true;
                } catch { return false; }
            }

            function applyView(v) {
                root.dataset.view = v;
                viewBtns.forEach(b => {
                    const active = b.dataset.view === v;
                    b.classList.toggle('is-active', active);
                    b.setAttribute('aria-pressed', String(active));
                });
            }

            let toastTimer = null;
            function showToast(text, warn) {
                toastText.textContent = text;
                toast.classList.toggle('is-warn', !!warn);
                toast.classList.add('is-show');
                clearTimeout(toastTimer);
                toastTimer = setTimeout(() => toast.classList.remove('is-show'), 2800);
            }

            const savedView = readSavedView();
            applyView(savedView ?? 'cards');
            if (!savedView && viewHint) viewHint.hidden = false;

            viewBtns.forEach(btn => btn.addEventListener('click', () => {
                const v = btn.dataset.view;
                if (!VIEWS[v]) return;

                applyView(v);
                if (viewHint) viewHint.hidden = true;

                const ok = saveView(v);
                showToast(
                    ok ? `نمایش «${VIEWS[v]}» ذخیره شد و دفعه‌ی بعد هم همین را می‌بینید`
                       : `نمایش «${VIEWS[v]}» انتخاب شد (ذخیره‌سازی در این مرورگر ممکن نیست)`,
                    !ok);

                hydratePhotos();   // اگر عکسی هنوز لود نشده بود
            }));

            // ─────────────── نمایش‌ها ───────────────

            const loadingView = () => `
                <div class="pd-loading">
                    <span class="pd-loading-note" id="loadingNote">
                        <i class="pd-pulse"></i> در حال دریافت اطلاعات…
                    </span>
                </div>
                <div class="pd-grid">${'<div class="pd-skel"></div>'.repeat(8)}</div>`;

            const errorView = () => `
                <div class="pd-state">
                    <div class="pd-state-icon"><i class="fas fa-plug"></i></div>
                    <h2>اطلاعات بارگذاری نشد</h2>
                    <p>اتصال به سرور برقرار نشد. لطفاً دوباره تلاش کنید.</p>
                    <button type="button" class="pd-retry" data-retry>تلاش دوباره</button>
                </div>`;

            function setLoadingNote(text) {
                const note = document.getElementById('loadingNote');
                if (note) note.innerHTML = `<i class="pd-pulse"></i> ${text}`;
            }

            // ─────────────── دریافت با تلاش مجدد ───────────────

            async function fetchResults(fd, signal) {
                let lastError;

                for (let attempt = 1; attempt <= MAX_ATTEMPTS; attempt++) {
                    if (signal.aborted) throw new DOMException('Aborted', 'AbortError');

                    try {
                        const res = await fetch(SEARCH_URL, {
                            method: 'POST',
                            headers: { 'X-Requested-With': 'XMLHttpRequest' },
                            body: fd,
                            signal
                        });

                        if (!res.ok) throw new Error('HTTP ' + res.status);

                        const html = await res.text();
                        const doc = new DOMParser().parseFromString(html, 'text/html');

                        if (!doc.querySelector('#results-partial')) {
                            throw new Error('ساختار پاسخ سرور صحیح نیست');
                        }
                        return doc;
                    } catch (err) {
                        if (err?.name === 'AbortError') throw err;

                        lastError = err;
                        console.warn(`PhoneDirectory: attempt ${attempt}/${MAX_ATTEMPTS} failed`, err);

                        if (attempt < MAX_ATTEMPTS) {
                            setLoadingNote(`اتصال برقرار نشد — تلاش مجدد (${fa(attempt + 1)} از ${fa(MAX_ATTEMPTS)})…`);
                            await sleep(600 * 2 ** (attempt - 1));   // ۶۰۰، ۱۲۰۰، ۲۴۰۰ میلی‌ثانیه
                        }
                    }
                }
                throw lastError;
            }

            async function load() {
                controller?.abort();
                controller = new AbortController();
                const { signal } = controller;

                results.innerHTML = loadingView();
                pager.innerHTML = '';

                const fd = new FormData();
                fd.set('search', searchInput.value.trim());
                fd.set('type', typeInput?.value ?? '');
                fd.set('page', String(page));
                fd.set('pageSize', String(PAGE_SIZE));

                try {
                    applyResults(await fetchResults(fd, signal));
                } catch (err) {
                    if (err?.name === 'AbortError') return;
                    console.error('PhoneDirectory:', err);
                    results.innerHTML = errorView();
                    pager.innerHTML = '';
                }
            }

            function applyResults(doc) {
                results.innerHTML = doc.querySelector('#results-partial').innerHTML;
                pager.innerHTML = doc.querySelector('#pagination-partial')?.innerHTML ?? '';
                const total = doc.querySelector('#total-count-value')?.dataset.total;
                totalEl.textContent = fa(total ?? 0);
                // اگر سرور شماره‌ی صفحه را اصلاح کرده باشد
                const activePage = pager.querySelector('[aria-current="page"]')?.dataset.page;
                if (activePage) page = Number(activePage);
                hydratePhotos();
            }

            // ─────────────── عکس‌ها ───────────────
            // عکس داخل <img> نمی‌آید: با fetch گرفته و روی canvas کشیده می‌شود
            // تا آدرس مستقیمی در صفحه نماند و «ذخیره‌ی تصویر» در دسترس نباشد.

            const photoObserver = 'IntersectionObserver' in window
                ? new IntersectionObserver(entries => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            photoObserver.unobserve(entry.target);
                            loadPhoto(entry.target);
                        }
                    });
                }, { rootMargin: '250px' })
                : null;

            function hydratePhotos() {
                results.querySelectorAll('.pd-portrait[data-photo]').forEach(el => {
                    if (photoObserver) photoObserver.observe(el);
                    else loadPhoto(el);
                });
            }

            async function loadPhoto(el) {
                const url = el.dataset.photo;
                el.removeAttribute('data-photo');          // آدرس بعد از استفاده از DOM پاک می‌شود
                const canvas = el.querySelector('canvas');
                if (!url || !canvas) return;

                for (let attempt = 1; attempt <= 3; attempt++) {
                    try {
                        const res = await fetch(url, {
                            credentials: 'same-origin',
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });

                        if (res.status === 404) return;     // عکسی برای این نفر ثبت نشده
                        if (!res.ok) throw new Error('HTTP ' + res.status);

                        const bitmap = await createImageBitmap(await res.blob());
                        const scale = Math.max(canvas.width / bitmap.width, canvas.height / bitmap.height);
                        const w = bitmap.width * scale;
                        const h = bitmap.height * scale;

                        canvas.getContext('2d').drawImage(
                            bitmap, (canvas.width - w) / 2, (canvas.height - h) * 0.15, w, h);

                        bitmap.close?.();
                        el.classList.add('has-photo');
                        return;
                    } catch (err) {
                        if (attempt < 3) await sleep(500 * attempt);
                    }
                }
            }

            // جلوگیری از کلیک راست / کشیدن / انتخاب روی قاب عکس
            ['contextmenu', 'dragstart', 'selectstart'].forEach(type => {
                results.addEventListener(type, e => {
                    if (e.target.closest?.('.pd-portrait')) e.preventDefault();
                });
            });

            // ─────────────── جستجو و فیلتر ───────────────

            function scheduleSearch() {
                page = 1;
                clearTimeout(timer);
                timer = setTimeout(load, 180);
            }

            form.addEventListener('submit', e => {
                e.preventDefault();
                page = 1;
                clearTimeout(timer);
                load();
            });

            searchInput.addEventListener('input', scheduleSearch);

            clearBtn?.addEventListener('click', () => {
                if (!searchInput.value) { searchInput.focus(); return; }
                searchInput.value = '';
                searchInput.focus();
                page = 1;
                load();
            });

            chips.forEach(chip => chip.addEventListener('click', () => {
                chips.forEach(c => {
                    const active = c === chip;
                    c.classList.toggle('is-active', active);
                    c.setAttribute('aria-pressed', String(active));
                });
                if (typeInput) typeInput.value = chip.dataset.type ?? '';
                page = 1;
                load();
            }));

            // صفحه‌بندی
            pager.addEventListener('click', e => {
                const btn = e.target.closest('[data-page]');
                if (!btn || btn.disabled) return;

                const target = Number(btn.dataset.page);
                if (!Number.isInteger(target) || target < 1 || target === page) return;

                page = target;
                load();
                results.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });

            // تلاش دوباره‌ی دستی
            results.addEventListener('click', e => {
                if (e.target.closest('[data-retry]')) load();
            });

            // وقتی اینترنت/شبکه برگشت و صفحه در حالت خطاست، خودکار دوباره تلاش کن
            window.addEventListener('online', () => {
                if (results.querySelector('[data-retry]')) load();
            });

            // کپی شماره
            results.addEventListener('click', async e => {
                const btn = e.target.closest('.pd-copy');
                if (!btn) return;

                const text = btn.dataset.copy;
                if (!text) return;

                try {
                    if (!navigator.clipboard || !window.isSecureContext) throw new Error('no clipboard');
                    await navigator.clipboard.writeText(text);
                } catch {
                    const ta = document.createElement('textarea');
                    ta.value = text;
                    ta.style.cssText = 'position:fixed;opacity:0';
                    document.body.appendChild(ta);
                    ta.select();
                    document.execCommand('copy');
                    ta.remove();
                }

                const original = btn.innerHTML;
                btn.classList.add('is-done');
                btn.innerHTML = '<i class="fas fa-check"></i>';
                setTimeout(() => {
                    btn.classList.remove('is-done');
                    btn.innerHTML = original;
                }, 1400);
            });

            // میانبر: کلید / برای رفتن به جستجو
            document.addEventListener('keydown', e => {
                if (e.key === '/' && document.activeElement !== searchInput
                    && !/input|textarea|select/i.test(document.activeElement?.tagName ?? '')) {
                    e.preventDefault();
                    searchInput.focus();
                }
            });

            // صفحه‌ی اول همراه صفحه آمده است؛ فقط اگر نیامده (کش سرد) درخواست زده می‌شود
            const initial = document.getElementById('pdInitial');
            if (initial && initial.content.querySelector('#results-partial')) {
                applyResults(initial.content);
                initial.remove();
            } else {
                load();
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initPhoneDirectory);
        } else {
            initPhoneDirectory();
        }
    </script>
}