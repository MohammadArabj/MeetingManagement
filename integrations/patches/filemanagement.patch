+                    var policyError = new FileTypePolicy(configuration).Validate(filename);
+                    if (policyError != null)
+                    {
+                        eventContext.FailRequest(System.Net.HttpStatusCode.UnsupportedMediaType, policyError);
+                        return;
+                    }
+                    // بررسی حجم 
